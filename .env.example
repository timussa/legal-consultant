LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=
MAX_WORKERS=2
MAX_TOKENS=3000
ENABLE_EMBEDDINGS=true

# Separate providers are optional. A separate URL requires its own key.
EMBEDDER_BASE_URL=
EMBEDDER_API_KEY=
RERANKER_BASE_URL=
RERANKER_API_KEY=
CHAT_JSON_MODE=false
CHAT_THINKING=

# Web backend: accounts and sessions (server/config.py).
# Demo accounts lawyer, lawyer2 and head are created on the first start when the user table is empty.
# The password below is a public test value for the prototype. Change it before any shared deployment.
DEMO_USERS=true
DEMO_PASSWORD=demo-psb-2026
# Instead of demo accounts: login:password:role:Name[:Position];... (role is lawyer or head)
BOOTSTRAP_USERS=
SESSION_TTL_HOURS=12
# Set to true behind HTTPS.
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
ASK_PER_MINUTE=20
APP_UTC_OFFSET_HOURS=3
ALLOW_KB_UPLOADS=true
