# Local development. Copy to .env, then enter your own keys.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
CHAT_JSON_MODE=true
CHAT_THINKING=disabled

# Optional dense search. Add a DeepInfra key, then set ENABLE_EMBEDDINGS=true.
EMBEDDER_BASE_URL=https://api.deepinfra.com/v1/openai
EMBEDDER_API_KEY=
EMB_MODEL=BAAI/bge-m3
ENABLE_EMBEDDINGS=false

# Optional reranker. Add a SiliconFlow key and model ID to enable.
RERANKER_BASE_URL=https://api.siliconflow.com/v1
RERANKER_API_KEY=
RERANKER_MODEL=
# RERANKER_MODEL=Qwen/Qwen3-Reranker-8B
MAX_WORKERS=2
MAX_TOKENS=3000

# Web backend: accounts and sessions (server/config.py).
# Demo accounts lawyer, lawyer2 and head are created on the first start when the user table is empty.
# The password below is a public test value for the prototype. Change it before any shared deployment.
DEMO_USERS=true
DEMO_PASSWORD=demo-psb-2026
# Instead of demo accounts: login:password:role:Name[:Position];... (role is lawyer or head)
BOOTSTRAP_USERS=
SESSION_TTL_HOURS=12
# Set to true behind HTTPS.
COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
ASK_PER_MINUTE=20
APP_UTC_OFFSET_HOURS=3
ALLOW_KB_UPLOADS=true
